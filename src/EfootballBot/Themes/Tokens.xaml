<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ==================================================================
         Tokens.xaml —— 颜色 / 阴影：全应用唯一的颜色真相（5 套主题）
         本文件为默认主题 Obsidian（黑曜极夜）的兜底 / 设计器预览值：
         运行时 ThemeManager.ApplyTheme 会按所选主题覆盖全部 token。
         ================================================================== -->
    <!-- ===== 底层：窗口与三栏 ===== -->
    <SolidColorBrush x:Key="WindowBg" Color="#FF08080A"/>
    <SolidColorBrush x:Key="ContentBg" Color="#F208080A"/>
    <SolidColorBrush x:Key="CardBg" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="SideLeftBg" Color="#59000000"/>
    <SolidColorBrush x:Key="SideRightBg" Color="#42000000"/>
    <SolidColorBrush x:Key="Surface2" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="InsetBg" Color="#0A000000"/>
    <SolidColorBrush x:Key="TrackBg" Color="#4D000000"/>
    <SolidColorBrush x:Key="GlassBg" Color="#D9101012"/>
    <SolidColorBrush x:Key="GlassStroke" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="DialogBg" Color="#F5141418"/>
    <SolidColorBrush x:Key="ControlFill" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="ControlStroke" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="ChromeGlass" Color="#4D08080A"/>

    <!-- ===== 文字（三级：主 白 / 次 #E5E5EA / 弱 #98989F） ===== -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF98989F"/>
    <SolidColorBrush x:Key="NavLabelFg" Color="#FF98989F"/>
    <SolidColorBrush x:Key="NavDescFg" Color="#FFB8B8BF"/>
    <SolidColorBrush x:Key="SegTabFg" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="SegTabHover" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SegTabHoverFg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="LogInfo" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="LogTime" Color="#FF7E8694"/>
    <SolidColorBrush x:Key="LogTag" Color="#FFD4D4DC"/>

    <!-- ===== 强调色（默认 Obsidian 黑曜极夜：高对比珍珠白） ===== -->
    <SolidColorBrush x:Key="Accent" Color="#FFF2F2F7"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentGlow" Color="#FFD4D4DC"/>
    <SolidColorBrush x:Key="AccentLight" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="AccentBorderStrong" Color="#78FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FF111113"/>

    <!-- ===== 语义色 ===== -->
    <SolidColorBrush x:Key="Danger" Color="#FFEF4444"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FFF87171"/>
    <SolidColorBrush x:Key="DangerText" Color="#FFFCA5A5"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#66EF4444"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26EF4444"/>
    <SolidColorBrush x:Key="TextOnDanger" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Warning" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="Success" Color="#FF10B981"/>
    <SolidColorBrush x:Key="Info" Color="#FFD4D4DC"/>
    <SolidColorBrush x:Key="Amber" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="Orange" Color="#FFFB923C"/>
    <SolidColorBrush x:Key="Teal" Color="#FF2DD4BF"/>

    <!-- ===== 输入 / 轨道 / 滚动 ===== -->
    <SolidColorBrush x:Key="InputBg" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="InputBorder" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HoverOverlay" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="ToggleOff" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="ToggleOn" Color="#FF30D158"/>
    <SolidColorBrush x:Key="ToggleThumbOn" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ModuleDot" Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="EnvDotIdle" Color="#FF8E8E93"/>

    <!-- ===== 描边 / 遮罩 / 预览 ===== -->
    <SolidColorBrush x:Key="Divider" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="HairlineStrong" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="Scrim" Color="#F0000000"/>
    <SolidColorBrush x:Key="ScrimSoft" Color="#CC000000"/>
    <SolidColorBrush x:Key="PreviewBg" Color="#FF000000"/>
    <SolidColorBrush x:Key="NavSectionBg" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="NavSectionBorder" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="TabTrackBg" Color="#4D000000"/>
    <SolidColorBrush x:Key="IntlTabBg" Color="#4D000000"/>
    <SolidColorBrush x:Key="IntlTabBorder" Color="#1FFFFFFF"/>

    <!-- ===== 品牌 / 横幅 ===== -->
    <SolidColorBrush x:Key="BrandFrom" Color="#FF3A3A42"/>
    <SolidColorBrush x:Key="BrandTo" Color="#FF1C1C22"/>
    <SolidColorBrush x:Key="BannerFrom" Color="#FF2C2C34"/>
    <SolidColorBrush x:Key="BannerTo" Color="#FF18181E"/>
    <SolidColorBrush x:Key="TextOnBanner" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="HeroGlowFrom" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="HeroGlowFade" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="HeroTitleFrom" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="HeroTitleMid" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="HeroTitleTo" Color="#FFA1A1AA"/>

    <!-- ===== 浮层 ===== -->
    <SolidColorBrush x:Key="TooltipBg" Color="#F2242428"/>
    <SolidColorBrush x:Key="TooltipBorder" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="TooltipFg" Color="#FFFFFFFF"/>

    <!-- ===== 阴影 ===== -->
    <DropShadowEffect x:Key="FloatShadow" Color="#FF000000" BlurRadius="24"
                      ShadowDepth="1" Opacity="0.22"/>
    <DropShadowEffect x:Key="AccentShadow" Color="#55FFFFFF" BlurRadius="18"
                      ShadowDepth="0" Opacity="0.24"/>
    <DropShadowEffect x:Key="CardShadowEffect" Color="#FF000000" BlurRadius="16"
                      ShadowDepth="4" Opacity="0.36"/>

    <!-- ===== 玻璃质感渐变 ===== -->
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.16"/>
        <GradientStop Color="#09FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentPillFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBtnFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4AFFFFFF" Offset="0"/>
        <GradientStop Color="#36FFFFFF" Offset="0.55"/>
        <GradientStop Color="#28FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardTopHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="{DynamicResource HairlineStrongColor}" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 渐变停点专用 Color 版 ===== -->
    <Color x:Key="BrandFromColor">#FF3A3A42</Color>
    <Color x:Key="BrandToColor">#FF1C1C22</Color>
    <Color x:Key="AccentColor">#FFF2F2F7</Color>
    <Color x:Key="AccentHoverColor">#FFFFFFFF</Color>
    <Color x:Key="HairlineStrongColor">#3DFFFFFF</Color>
    <SolidColorBrush x:Key="SelectFill" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="SelectFillStrong" Color="#36FFFFFF"/>
    <SolidColorBrush x:Key="SelectBorder" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="SelectFg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SelectBar" Color="#FFF2F2F7"/>
    <SolidColorBrush x:Key="TopBarBg" Color="#4D08080A"/>
    <SolidColorBrush x:Key="SubTabSelFill" Color="#5C42424A"/>
    <SolidColorBrush x:Key="SubTabSelStroke" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="ChipFill" Color="#3D000000"/>
    <SolidColorBrush x:Key="ChipStroke" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="TextOnPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBtnStroke" Color="#7AFFFFFF"/>
    <SolidColorBrush x:Key="BtnFlash" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ComboBg" Color="#2A242428"/>
    <SolidColorBrush x:Key="ComboPopupBg" Color="#F0151518"/>
    <Color x:Key="HeroGlowFromColor">#16FFFFFF</Color>
    <Color x:Key="HeroGlowFadeColor">#00FFFFFF</Color>
    <Color x:Key="HeroTitleFromColor">#FFFFFFFF</Color>
    <Color x:Key="HeroTitleMidColor">#FFE5E5EA</Color>
    <Color x:Key="HeroTitleToColor">#FFA1A1AA</Color>
    <Color x:Key="BannerFromColor">#FF2C2C34</Color>
    <Color x:Key="BannerToColor">#FF18181E</Color>

    <ImageBrush x:Key="DitherNoiseBrush"
                ImageSource="pack://application:,,,/Assets/dither-noise.png"
                TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute"
                Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
</ResourceDictionary>
