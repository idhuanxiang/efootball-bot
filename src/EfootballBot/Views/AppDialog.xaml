<Window x:Class="EfootballBot.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        Foreground="{DynamicResource TextPrimary}">
    <Border x:Name="Shell" CornerRadius="12" BorderBrush="{DynamicResource GlassStroke}"
            BorderThickness="1" Background="{DynamicResource DialogBg}" Padding="0"
            Effect="{StaticResource FloatShadow}">
        <StackPanel>
            <!-- 自绘标题栏：可拖拽，右侧关闭按钮 -->
            <Grid Height="38" Margin="16,0,10,0" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="TitleDot" Width="7" Height="7" Fill="{DynamicResource Accent}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtTitle" Text="提示" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="关闭" Click="OnCancel"
                        Foreground="{DynamicResource TextMuted}" FontSize="14"
                        Content="✕">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Margin="20,4,20,18">
                <TextBlock x:Name="TxtMessage" FontSize="13" LineHeight="20"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                           Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostBtn}"
                            MinWidth="84" Margin="0,0,10,0" Click="OnCancel" Visibility="Collapsed"/>
                    <Button x:Name="OkBtn" Content="确定" Style="{StaticResource PrimaryBtn}"
                            MinWidth="92" Click="OnOk"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
