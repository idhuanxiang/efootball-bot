<Window x:Class="EfootballBot.Views.StartConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始挂机前确认" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="Microsoft YaHei UI"
        Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}">
    <Border Padding="22,20" Background="{DynamicResource CardBg}">
        <StackPanel>
            <TextBlock Text="开始挂机前确认" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
            <TextBlock Text="开始前请确认两件事：" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
            <Border Background="{DynamicResource ChipFill}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                               Text="① 真实手柄随时可拿去玩" Margin="0,0,0,4"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                               Text="挂机中检测到你在用真实手柄会自动让路（虚拟手柄暂时断开，你的手柄立刻可用）；停手后自动恢复继续挂机。注意：虚拟手柄占用玩家 1，挂机运行中请勿同时用两只手柄玩同一个游戏。"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ChipFill}" CornerRadius="8" Padding="12,10" Margin="0,0,6,14">
                <StackPanel>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                               Text="② 游戏最好以 720p 窗口模式运行" Margin="0,0,0,4"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                               Text="无边框窗口 1280×720 最稳定；独占全屏下挂机无法窗口化且定位易失效。"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="CountdownHint" Text="" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                       Margin="0,0,0,8" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkBtn" Content="确定" Style="{StaticResource PrimaryBtn}"
                        Width="96" Margin="0,0,10,0" Click="OnOk"/>
                <Button Content="取消" Style="{StaticResource GhostBtn}" Width="96" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
